        "jsCode": "// const callback = $json.callback_query;\n\n// if (!callback) {\n//   return [{\n//     json: {\n//       valid_command: false,\n//       error: 'No callback query received'\n//     }\n//   }];\n// }\n\n// const callbackData = String(callback.data || '').trim();\n\n// const parts = callbackData.split('|');\n\n// const action = String(parts[0] || '').trim().toUpperCase();\n// const requestId = String(parts[1] || '').trim();\n\n// const chatId = String(\n//   callback.message?.chat?.id || ''\n// );\n\n// const userId = String(\n//   callback.from?.id || ''\n// );\n\n// return [{\n//   json: {\n//     action,\n//     request_id: requestId,\n\n//     telegram_chat_id: chatId,\n//     telegram_user_id: userId,\n\n//     authorized_chat: chatId === '5246817966',\n//     authorized_user: userId === '5246817966',\n\n//     valid_command:\n//       (action === 'APPROVE' || action === 'REJECT') &&\n//       !!requestId,\n\n//     callback_query_id: callback.id\n//   }\n// }];\n\n\n\nconst callback = $json.callback_query;\n\nif (!callback) {\n  return [{\n    json: {\n      valid_command: false,\n      error: 'No callback query received'\n    }\n  }];\n}\n\nconst callbackData = String(callback.data || '').trim();\n\nconst parts = callbackData.split('|');\n\nconst action = String(parts[0] || '').trim().toUpperCase();\nconst requestId = String(parts[1] || '').trim();\n\nconst chatId = String(\n  callback.message?.chat?.id || ''\n);\n\nconst userId = String(\n  callback.from?.id || ''\n);\n\nreturn [{\n  json: {\n    action,\n    request_id: requestId,\n\n    telegram_chat_id: chatId,\n    telegram_user_id: userId,\n\n    authorized_chat: chatId === '5246817966',\n    authorized_user: userId,\n\n    valid_command:\n      (action === 'APPROVE' || action === 'REJECT' || action === 'MARK_REVIEWED') &&\n      !!requestId,\n\n    callback_query_id: callback.id\n  }\n}];"
      },
